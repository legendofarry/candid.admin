{
  "name": "candid-owner-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1 --port 4174\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "npm run start",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "vite": "8.1.5"
  }
}
