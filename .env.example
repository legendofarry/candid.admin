# Use the same Firebase project as the Candid main app.
# Keep this server-side only; never put service-account credentials in VITE_* variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Server-only credentials for previewing authenticated employment proof in the owner console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local owner API server. Vite runs separately on port 4174.
PORT=4176
# Optional comma-separated allowlist for Netlify team users permitted in the owner console.
OWNER_ADMIN_EMAILS=
